{
  "realm": "ecommerce",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "Can shop" },
      { "name": "ADMIN", "description": "Can manage catalog, stock and orders" }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-cli",
      "name": "Developer tools (.http files, tests by hand)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-ecommerce-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ecommerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "ecommerce-web",
      "name": "Future web frontend",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-ecommerce-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ecommerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Nguyen",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Tran",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "shop-admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Shop",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "shop-admin", "temporary": false }],
      "realmRoles": ["ADMIN", "CUSTOMER"]
    }
  ]
}