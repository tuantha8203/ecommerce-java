# Superadmin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Password riêng từng database (2.2) — username luôn cố định "{tên}_user", không cần khai ở đây
KEYCLOAK_DB_USERNAME=keycloak_user
KEYCLOAK_DB_PASSWORD=changeme
PRODUCT_DB_USERNAME=product_user
PRODUCT_DB_PASSWORD=changeme
INVENTORY_DB_USERNAME=inventory_user
INVENTORY_DB_PASSWORD=changeme
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=changeme
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=changeme

# Keycloak admin console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# RabbitMQ
RABBITMQ_DEFAULT_USER=app_user
RABBITMQ_DEFAULT_PASS=changeme

# Port host — trùng port với service khác trên máy thì chỉ cần đổi ở đây, không đụng docker-compose.infra.yml
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8089
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MONGODB_PORT=27017
ELASTICSEARCH_PORT=9200
KEYCLOAK_PORT=8180
EUREKA_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888